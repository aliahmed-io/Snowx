# Database (Prisma)
# Use "transaction" connection pooler for serverless environments (Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public&connection_limit=10"
# Optional: Direct connection for migrations if using a pooler
# DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# Kinde Auth (Authentication)
# Get these from your Kinde Dashboard -> Settings -> Applications
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_ISSUER_URL=https://your-business.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/api/auth/creation

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The email address that will automatically be assigned the 'ADMIN' role on signup
ADMIN_EMAIL=admin@example.com

# Stripe (Payments)
# Get these from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get this from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# UploadThing (File Uploads)
# Get these from UploadThing Dashboard -> API Keys
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...

# Resend (Email)
# Get this from Resend Dashboard -> API Keys
RESEND_API_KEY=re_...

# Upstash Redis (Caching)
# Get these from Upstash Console -> Database -> Details
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
